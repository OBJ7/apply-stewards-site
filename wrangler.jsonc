{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apply-stewards",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "alias": { "@netlify/blobs": "./cloudflare/blobs.mjs" },
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/.netlify/functions/*"],
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "vars": { "HISTORICAL_DATA_STATUS": "pending" },
  "triggers": { "crons": ["0 6 * * *"] }
}
